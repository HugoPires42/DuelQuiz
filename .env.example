# Config Firebase (app Web) — copie ce fichier en .env.local et remplis tes valeurs.
# .env.local n'est PAS versionné. Ces valeurs sont de la config client publique,
# mais on les garde hors du dépôt et on sécurise l'accès via les règles Firestore.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
