rules_version = '2';

// Règles de sécurité Firestore — QuizDuel
// Principe : auth requise partout ; chaque joueur ne peut écrire QUE ses
// propres données ; le reste est refusé par défaut.
service cloud.firestore {
  match /databases/{database}/documents {

    // ───── Profils des joueurs ─────
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // ───── Registre d'unicité des identifiants « pseudo#tag » ─────
    match /usernames/{key} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ───── Demandes d'amis ─────
    match /friendRequests/{id} {
      // Lisible par l'expéditeur et le destinataire.
      allow read: if request.auth != null &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      // On n'envoie une demande qu'EN SON NOM, et pas à soi-même.
      allow create: if request.auth != null &&
        request.resource.data.from == request.auth.uid &&
        request.resource.data.to != request.auth.uid;
      // Accepter / refuser / annuler : l'un des deux concernés.
      allow update, delete: if request.auth != null &&
        (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }

    // ───── Amitiés (document partagé par les 2 joueurs) ─────
    match /friendships/{pairId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      // Créable uniquement par un des 2 participants, avec exactement 2 membres.
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.users &&
        request.resource.data.users.size() == 2;
      allow delete: if request.auth != null && request.auth.uid in resource.data.users;
      allow update: if false;
    }

    // Tout le reste est refusé par défaut (aucune règle = accès refusé).
  }
}
